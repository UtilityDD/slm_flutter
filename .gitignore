# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related (tool/build_release.sh writes Dart symbols to build/symbols/, already
# covered by /build/; these catch --split-debug-info runs pointed elsewhere)
app.*.symbols
/symbols/
*.symbols

# Kotlin / Gradle / native build caches
.kotlin/
**/android/.kotlin/
.gradle/
.cxx/
*.hprof

# Temp files and screen recordings (keep media sources in tool/media_src/, never in the repo root)
*.tmp
*.bak
*~
/tmp/
*.mp4
*.mov
*.webm
*.mkv
!tool/media_src/**

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/.gradle/

# Widget Preview related
.widget_preview/

# Secrets and local environment
.env
.env*
secrets.json
*.local
key.properties
*.jks
*.keystore

# Hourly answer keys. Never ship these in the app.
/tool/hourly_answer_keys.json
/tool/hourly_answer_keys.sql

